{
  "name": "quick-cut",
  "version": "0.2.0",
  "description": "Minimal desktop app for video cutting and subtitle styling.",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -b tsconfig.json && pnpm run copy-static",
    "copy-static": "cpx \"src/renderer/**/*.{html,css}\" dist/renderer",
    "start": "pnpm run build && electron .",
    "dev": "tsc -b tsconfig.json --watch",
    "test": "vitest run",
    "package:mac": "pnpm run build && electron-builder --mac",
    "package:win": "pnpm run build && electron-builder --win",
    "package": "pnpm run build && electron-builder -mwl"
  },
  "build": {
    "appId": "com.quickcut.editor",
    "productName": "QuickCut",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    }
  },
  "keywords": [
    "video",
    "subtitle",
    "editor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron": "^28.2.3"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "cpx": "^1.5.0",
    "electron-builder": "^24.13.3",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  }
}
