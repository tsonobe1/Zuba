{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",
    "types": ["node"],
    "lib": ["ES2020"],
    "composite": true
  },
  "include": ["src/main/**/*.ts", "src/preload/**/*.ts", "src/types/**/*.d.ts"],
  "exclude": ["src/renderer"]
}
